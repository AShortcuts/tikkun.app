# Optional overrides for config/analytics-public.json. Export before building.
# An explicitly empty key disables collection on that surface.
TIKKUN_ANALYTICS_WEB_KEY=
TIKKUN_ANALYTICS_APP_KEY=
TIKKUN_ANALYTICS_SITE_ORIGIN=https://tikkunreader.com
TIKKUN_ANALYTICS_APP_ORIGIN=https://app.tikkunreader.com
TIKKUN_ANALYTICS_APP_COLLECTOR=https://adamn.cc/api/echo

# SERVER ONLY. Set as a Pages secret and in Caddy's private environment.
# Never use a VITE_ prefix or place a real relay secret in source control.
MELYTICS_RELAY_TOKEN=
