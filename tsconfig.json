{
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "noEmit": true,
    "allowJs": true,
    "module": "ESNext",
    "target": "ES2020",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "allowImportingTsExtensions": true
  },
  "include": ["./app/**/*", "./generated/**/*"]
}
