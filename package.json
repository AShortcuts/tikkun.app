{
  "name": "tikkun.io",
  "version": "1.0.0",
  "description": "The online tikkun you always wanted, but never had.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "audio:sync": "node scripts/generate-audio-manifest.mjs",
    "video:manifest": "node --experimental-transform-types scripts/generate-video-manifest.mjs",
    "video:record": "node --experimental-transform-types scripts/record-aliyah-videos.mjs",
    "video:calibrate": "node --experimental-transform-types scripts/record-aliyah-videos.mjs calibrate",
    "video:cleanup": "node --experimental-transform-types scripts/record-aliyah-videos.mjs cleanup",
    "video:shut-down": "pkill -f record-aliyah-videos || true; pkill -f \"Brave Browser\" || true; pkill -f vite || true; npm run video:cleanup",
    "test": "vitest run",
    "vitest": "vitest",
    "test:watch": "vitest",
    "dev": "vite",
    "build": "vite build && node scripts/generate-service-worker.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint src scripts/*.mjs vite.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test:browser": "vitest --workspace=vitest.workspace.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akivajgordon/tikkun.io.git"
  },
  "author": "Akiva Gordon <akivag29@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/akivajgordon/tikkun.io/issues"
  },
  "homepage": "https://github.com/akivajgordon/tikkun.io#readme",
  "dependencies": {
    "@hebcal/core": "^5.7.7",
    "@hebcal/hdate": "^0.12.0",
    "@hebcal/leyning": "^9.0.1",
    "normalize.css": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^25.5.0",
    "@vitest/browser": "^2.1.9",
    "eslint": "^10.1.0",
    "globals": "^15.9.0",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
